        /* Print Styles for ZATCA Invoice */
        @media print {
            .sidebar, .no-print { display: none !important; }
            .main-content { margin: 0; padding: 0; }
            .print-only { display: block !important; }
            body { background: white; }
        }
        .print-only { display: none; }
    </style>
</head>
