    <!-- JAVASCRIPT LOGIC -->
    <script>
        // --- NAVIGATION LOGIC ---
        function showSection(sectionId) {
            document.querySelectorAll('.content-section').forEach(el => el.classList.add('hidden'));
            document.getElementById(sectionId).classList.remove('hidden');
            
            const titles = {
                'dashboard': 'Financial Dashboard',
                'invoicing': 'ZATCA E-Invoicing Portal',
                'payroll': 'Payroll & WPS Management',
                'ledger': 'General Ledger (IFRS)',
                'compliance': 'Regulatory Compliance'
            };
            document.getElementById('page-title').innerText = titles[sectionId];
        }

        // --- ZATCA INVOICE GENERATION LOGIC ---
        function generateInvoice(e) {
            e.preventDefault();
            
            // 1. Gather Data
            const clientName = document.getElementById('clientName').value;
            const clientVat = document.getElementById('clientVat').value;
            const subtotal = parseFloat(document.getElementById('subtotal').value);
            const vatRate = 0.15;
            const vatAmount = subtotal * vatRate;
            const totalAmount = subtotal + vatAmount;
            
            // Generate Unique Identifiers
            const uuid = crypto.randomUUID();
            const invoiceId = `INV-${new Date().getFullYear()}-${Math.floor(Math.random()*10000).toString().padStart(4,'0')}`;
            const issueDate = new Date().toISOString().split('T')[0];
            const issueTime = new Date().toTimeString().split(' ')[0].substring(0,5);

            // 2. Update Preview UI
            document.getElementById('emptyState').classList.add('hidden');
            document.getElementById('invoicePreview').classList.remove('opacity-50', 'pointer-events-none', 'select-none');
            
            document.getElementById('prev-client').innerText = clientName;
            document.getElementById('prev-vat').innerText = `VAT: ${clientVat}`;
            document.getElementById('prev-id').innerText = invoiceId;
            document.getElementById('prev-date').innerText = `${issueDate} ${issueTime}`;
            document.getElementById('prev-uuid').innerText = uuid;
            
            document.getElementById('prev-net').innerText = subtotal.toFixed(2);
            document.getElementById('prev-tax').innerText = vatAmount.toFixed(2);
            document.getElementById('prev-total').innerText = totalAmount.toFixed(2);
            
            document.getElementById('sum-net').innerText = subtotal.toFixed(2);
            document.getElementById('sum-tax').innerText = vatAmount.toFixed(2);
            document.getElementById('sum-total').innerText = totalAmount.toFixed(2) + " SAR";

            // 3. ZATCA QR Code Generation (Simplified TLV Structure)
            // Note: Real Phase 2 requires ECDSA signing. This simulates the Base64 TLV structure 
            // using SHA-256 hash of invoice data as a placeholder for the digital signature tag.
            const sellerName = "Global Recruiters Co. Ltd.";
            const sellerVat = "300123456700003";
            
            // Create Hash (Simulating Digital Signature)
            const hashString = `${sellerVat}${issueDate}${issueTime}${totalAmount}${vatAmount}${uuid}`;
            const hash = CryptoJS.SHA256(hashString).toString(CryptoJS.enc.Hex);
            document.getElementById('prev-hash').innerText = hash.substring(0, 32) + "...";

            // Build TLV (Tag-Length-Value) Byte Array for QR
            // Tags: 1=Seller, 2=VAT, 3=Timestamp, 4=Total, 5=VAT Amt, 6=Hash(Sig Placeholder)
            const tlvData = buildTLV(sellerName, sellerVat, `${issueDate} ${issueTime}`, totalAmount.toFixed(2), vatAmount.toFixed(2), hash);
            
            // Clear previous QR and generate new one
            document.getElementById("qrcode").innerHTML = "";
            new QRCode(document.getElementById("qrcode"), {
                text: arrayBufferToBase64(tlvData),
                width: 128,
                height: 128,
                correctLevel: QRCode.CorrectLevel.L
            });

            // Add to dashboard list
            addDashboardRow(invoiceId, clientName, totalAmount, hash.substring(0,12));
        }

        // Helper: Build TLV Byte Array (ZATCA Spec)
        function buildTLV(seller, vat, date, total, tax, hash) {
            const encoder = new TextEncoder();
            const tags = [];
            
            const addTag = (tagNum, value) => {
                const valBytes = encoder.encode(value);
                const len = valBytes.length;
                const tagByte = new Uint8Array([tagNum]);
                const lenByte = new Uint8Array([len]);
                return new Uint8Array([...tagByte, ...lenByte, ...valBytes]);
            };

            const t1 = addTag(1, seller);
            const t2 = addTag(2, vat);
            const t3 = addTag(3, date);
            const t4 = addTag(4, total);
            const t5 = addTag(5, tax);
            // Tag 6 is usually the ECDSA signature. We use hash bytes here for demo.
            const t6 = addTag(6, hash); 

            return new Uint8Array([...t1, ...t2, ...t3, ...t4, ...t5, ...t6]);
        }

        function arrayBufferToBase64(buffer) {
            let binary = '';
            const bytes = new Uint8Array(buffer);
            const len = bytes.byteLength;
            for (let i = 0; i < len; i++) {
                binary += String.fromCharCode(bytes[i]);
            }
            return window.btoa(binary);
        }

        function addDashboardRow(id, client, amount, hash) {
            const tbody = document.getElementById('dash-invoice-list');
            const row = `<tr class="border-b hover:bg-slate-50">
                <td class="p-3 font-mono text-xs">${id}</td>
                <td class="p-3">${client}</td>
                <td class="p-3 font-bold">${amount.toFixed(2)}</td>
                <td class="p-3"><span class="bg-green-100 text-green-800 px-2 py-1 rounded text-xs">Reported</span></td>
                <td class="p-3 font-mono text-xs text-slate-400">${hash}...</td>
            </tr>`;
            tbody.insertAdjacentHTML('afterbegin', row);
        }

        // Initialize Dashboard with dummy data
        addDashboardRow("INV-2024-0089", "Bin Laden Contracting", 23000.00, "a1b2c3d4e5f6");
        addDashboardRow("INV-2024-0088", "Nesma Partners", 15750.00, "f6e5d4c3b2a1");
    </script>
